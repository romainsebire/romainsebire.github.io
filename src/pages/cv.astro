---
import BaseLayout from "@layouts/BaseLayout.astro";
import { ArrowUpRight, DownloadSimple, EnvelopeSimple, LinkedinLogo, GithubLogo, Car } from "@phosphor-icons/react";
import { getLangFromUrl, useTranslations, localizedPath } from "@i18n/ui";
import { site, socials } from "@config/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isFr = lang === "fr";
const title = `CV - Romain Sebire`;
const cvPdfUrl = isFr ? site.cvPath : site.cvEnPath;

const experiences = isFr
  ? [
      {
        title: "Stage Ingénieur Data IA & Cybersécurité (PFE) : Construction d'un dataset cybersécurité & Fine-tuning d'un LLM SAST",
        org: "Orange SA",
        logo: "/images/logos/orange.webp",
        period: "Mars – Sept. 2026",
        location: "Mougins (06), France",
        items: [
          "Développement d'un orchestrateur d'agents IA pour récupérer automatiquement et en grande quantité le code source associé à des vulnérabilités connues (CVE) de logiciels open-source",
          "Filtrage du bruit et enrichissement des données récoltées par distillation de connaissances",
          "Fine-tuning LoRA d'un LLM (Qwen 3.6 27B) spécialisé en détection de vulnérabilités (SAST) sur GPU NVIDIA H100 (GCP) pour assister les auditeurs sécurité",
          "Déploiement du modèle sur GCP avec vLLM pour l'inférence via API et évaluation des performances",
        ],
        stack: ["LangGraph", "Serena MCP", "Tree-sitter", "Qwen", "Hugging Face", "Transformers", "PEFT", "LoRA", "GCP", "vLLM", "PyTorch"],
        recommendationLink: {
          url: "/assets/Recommandation_Orange_Romain_Sebire.pdf",
          text: "Consulter la recommandation de mon tuteur"
        },
        projectLink: {
          url: localizedPath("/projects/sast-llm-fine-tuning", lang),
          text: "En savoir plus"
        }
      },
      {
        title: "Stage Ingénieur R&D Vision par ordinateur (IA)",
        org: "Thèse AVIAREPT",
        logo: "/images/logos/imt-mines-ales.svg",
        period: "Janv. – Févr. 2026",
        location: "Alès (30), France",
        items: [
          "Développement d'un logiciel de synchronisation et d'acquisition via 3 caméras et une tablette graphique",
          "Fine-tuning de modèles de vision (YOLOv8-pose) pour identifier et reconstruire la trajectoire en 3D d'un stylo et faciliter la détection de la dysgraphie ou de troubles de l'écriture",
        ],
        stack: ["PyTorch", "Ultralytics", "YOLOv8-pose", "RealSense", "Qt", "Docker", "Fusion360", "Git"],
        projectLink: {
          url: localizedPath("/projects/aviarept", lang),
          text: "En savoir plus"
        }
      },
      {
        title: "Stage Consultant : Digitalisation du processus de murs qualité",
        org: "NTN-SNR",
        logo: "/images/logos/ntn-snr.svg",
        period: "Nov. – Déc. 2024",
        location: "Alès (30), France",
        items: [
          "Audit complet du flux de données des formulaires papier et des besoins des auditeurs qualité et des opérateurs",
          "Réalisation d'une maquette fonctionnelle (Figma) et d'un cahier des charges fonctionnel pour valider les besoins",
          "Rédaction des spécifications et des use cases sur Azure DevOps pour faciliter la transmission aux développeurs",
        ],
        stack: ["Figma", "Java", "Azure DevOps", "Power BI", "Spécifications fonctionnelles"]
      },
      {
        title: "Stage : Acquisition de données expérimentales et marketing",
        org: "Géochanvre",
        logo: "/images/logos/geochanvre.webp",
        period: "Mai – Juin 2024",
        location: "Lézinnes (89), France",
        items: [
          "Acquisition en laboratoire et interprétation de données de conduction thermique via un protocole standardisé (centre C2MA)",
          "Réalisation d'une étude de marché pour le lancement d'un nouveau produit (toiles de chanvre isolantes)",
        ],
        stack: ["Python", "Tests laboratoire", "Conduction thermique", "Analyse statistique"]
      },
    ]
  : [
      {
        title: "Data, AI & Cybersecurity Engineering Internship (Final Year): Cybersecurity Dataset & SAST LLM Fine-Tuning",
        org: "Orange SA",
        logo: "/images/logos/orange.webp",
        period: "Mar – Sep 2026",
        location: "Mougins, France",
        items: [
          "Built an AI agent orchestrator to automatically harvest large-scale source code associated with known open-source vulnerabilities (CVEs)",
          "Filtered noise and enriched collected data through knowledge distillation",
          "LoRA fine-tuning of an open-source LLM (Qwen 3.6 27B) on an NVIDIA H100 GPU (GCP) specialized in vulnerability detection (SAST) to assist security auditors",
          "Deployed the model on GCP with vLLM for API-accessible inference and evaluated detection performance",
        ],
        stack: ["LangGraph", "Serena MCP", "Tree-sitter", "Qwen", "Hugging Face", "Transformers", "PEFT", "LoRA", "GCP", "vLLM", "PyTorch"],
        recommendationLink: {
          url: "/assets/Recommandation_Orange_Romain_Sebire.pdf",
          text: "Read tutor recommendation"
        },
        projectLink: {
          url: localizedPath("/projects/sast-llm-fine-tuning", lang),
          text: "Learn more"
        }
      },
      {
        title: "R&D Computer Vision Engineering Internship (AI)",
        org: "AVIAREPT Thesis",
        logo: "/images/logos/imt-mines-ales.svg",
        period: "Jan – Feb 2026",
        location: "Alès, France",
        items: [
          "Developed multi-sensor synchronization and acquisition software across 3 cameras and a digitizing graphics tablet",
          "Fine-tuned computer vision models (YOLOv8-pose) to track and reconstruct 3D pen trajectories in order to support early detection of dysgraphia and writing disorders",
        ],
        stack: ["PyTorch", "Ultralytics", "YOLOv8-pose", "RealSense", "Qt", "Docker", "Fusion360", "Git"],
        projectLink: {
          url: localizedPath("/projects/aviarept", lang),
          text: "Learn more"
        }
      },
      {
        title: "Consulting Internship: Quality Wall Process Digitalization",
        org: "NTN-SNR",
        logo: "/images/logos/ntn-snr.svg",
        period: "Nov – Dec 2024",
        location: "Alès, France",
        items: [
          "Full audit of paper form data flows and requirements from quality auditors and shop-floor operators",
          "Created a functional Figma mockup and functional specifications to validate user needs",
          "Authored specifications and use cases on Azure DevOps to streamline handover to developers",
        ],
        stack: ["Figma", "Java", "Azure DevOps", "Power BI", "Functional specifications"]
      },
      {
        title: "Internship: Experimental Data Acquisition & Marketing",
        org: "Géochanvre",
        logo: "/images/logos/geochanvre.webp",
        period: "May – Jun 2024",
        location: "Lézinnes, France",
        items: [
          "Laboratory acquisition and analysis of thermal conductivity data under a standardized protocol",
          "Conducted a market study for the launch of a new insulating hemp fabric product",
        ],
        stack: ["Python", "Laboratory testing", "Thermal conductivity", "Statistical analysis"]
      },
    ];

const education = isFr
  ? [
      {
        title: "IMT Mines Alès : Diplôme d'ingénieur généraliste",
        logo: "/images/logos/imt-mines-ales.svg",
        period: "2023 – 2026",
        location: "Alès (30), France",
        items: [
          "Spécialisation : Intelligence Artificielle & Sciences des données",
          "Option : Advanced Deep Learning and Reinforcement Learning",
          "Parcours complémentaire : International and Responsible Business Developer (IRBD)",
        ],
      },
      {
        title: "Université Fédérale de Rio de Janeiro : Échange académique M1",
        logo: "/images/logos/ufrj.svg",
        period: "Mars – Août 2025",
        location: "Rio de Janeiro, Brésil",
        items: [
          "Cursus : Engenharia de Computação e Informação",
          "Travail en équipe multiculturelle",
          "Adaptation à un environnement académique international",
        ],
        projectsLink: {
          url: localizedPath("/experiences/ufrj", lang),
          text: "Voir l'échange académique"
        }
      },
      {
        title: "Lycée Malherbe : Classe préparatoire aux grandes écoles (MPSI, MP)",
        logo: "/images/logos/malherbe.webp",
        period: "2020 – 2023",
        location: "Caen (14), France",
        items: [],
      },
      {
        title: "Lycée Jean Rostand : Baccalauréat Scientifique (Spécialité Mathématiques)",
        logo: "/images/logos/rostand.webp",
        period: "2017 – 2020",
        location: "Caen (14), France",
        items: [],
      },
    ]
  : [
      {
        title: "IMT Mines Alès: Engineering degree",
        logo: "/images/logos/imt-mines-ales.svg",
        period: "2023 – 2026",
        location: "Alès, France",
        items: [
          "Specialisation: Artificial Intelligence & Data Science",
          "Option: Advanced Deep Learning and Reinforcement Learning",
          "Additional track: International and Responsible Business Developer (IRBD)",
        ],
      },
      {
        title: "Federal University of Rio de Janeiro: Academic exchange M1",
        logo: "/images/logos/ufrj.svg",
        period: "Mar – Aug 2025",
        location: "Rio de Janeiro, Brazil",
        items: [
          "Program: Engenharia de Computação e Informação",
          "Multicultural teamwork",
          "Adaptation to an international academic environment",
        ],
        projectsLink: {
          url: localizedPath("/experiences/ufrj", lang),
          text: "View academic exchange"
        }
      },
      {
        title: "Lycée Malherbe: Classes Préparatoires (MPSI, MP)",
        logo: "/images/logos/malherbe.webp",
        period: "2020 – 2023",
        location: "Caen, France",
        items: [],
      },
      {
        title: "Lycée Jean Rostand: Scientific Baccalauréat (Mathematics)",
        logo: "/images/logos/rostand.webp",
        period: "2017 – 2020",
        location: "Caen, France",
        items: [],
      },
    ];

const skills = [
  {
    label: isFr ? "Langages & Outils" : "Languages & Tools",
    items: ["Python", "Java", "Linux", "SQL", "Git", "Docker"],
  },
  {
    label: isFr ? "Deep Learning & IA" : "Deep Learning & AI",
    items: ["LLMs", "Reinforcement Learning", "Computer Vision", "Transformers"],
  },
  {
    label: isFr ? "IA Agentique & LLMs locaux" : "Agentic AI & Local LLMs",
    items: ["Agents", "Skills", "Serveurs MCP", "Claude Code", "Copilot CLI", "Google Antigravity", "Ollama", "LMstudio", "OpenCode", "vLLM"],
  },
];

const languages = [
  isFr ? "Français (natif)" : "French (native)",
  isFr ? "Anglais C1 (TOEIC)" : "English C1 (TOEIC)",
  isFr ? "Espagnol B1" : "Spanish B1",
  isFr ? "Portugais A2/B1" : "Portuguese A2/B1",
];
---

<BaseLayout {title} description={isFr ? "CV de Romain Sebire - expériences, formation, compétences" : "Romain Sebire's resume - experience, education, skills"}>
  <section class="container-wide cv">
    <header class="cv__head reveal">
      <div>
        <h1 class="display cv__title">Romain Sebire</h1>
        <p class="cv__subtitle">{isFr ? "Ingénieur Data & IA" : "Data & AI Engineer"}</p>
        <div class="cv__contact">
          <a class="cv__contact-item" href={socials.email} title={isFr ? "Envoyer un e-mail" : "Send email"} data-umami-event="Contact Email">
            <EnvelopeSimple weight="regular" />
            <span>{site.email}</span>
          </a>
          <a class="cv__contact-item" href={socials.linkedin} target="_blank" rel="noopener noreferrer" data-umami-event="LinkedIn Click">
            <LinkedinLogo weight="regular" />
            <span>LinkedIn</span>
            <ArrowUpRight weight="bold" class="inline-icon" />
          </a>
          <a class="cv__contact-item" href={socials.github} target="_blank" rel="noopener noreferrer" data-umami-event="GitHub Click">
            <GithubLogo weight="regular" />
            <span>GitHub</span>
            <ArrowUpRight weight="bold" class="inline-icon" />
          </a>
          <a class="cv__contact-item" href={site.url} target="_blank" rel="noopener noreferrer">
            <span>romainsebire.fr</span>
            <ArrowUpRight weight="bold" class="inline-icon" />
          </a>
          <div class="cv__contact-item muted">
            <Car weight="regular" />
            <span>{isFr ? "Permis B (Véhiculé)" : "Driving License (Car owner)"}</span>
          </div>
        </div>
      </div>
      <a class="btn btn--primary" href={cvPdfUrl} target="_blank" rel="noopener noreferrer" download data-umami-event="Télécharger le CV">
        <DownloadSimple weight="bold" />
        {isFr ? "Télécharger le CV" : "Download resume"}
        <span class="btn__icon"><ArrowUpRight weight="bold" /></span>
      </a>
    </header>

    <div class="cv__grid">
      <div class="cv__col">
        <section class="cv__section reveal">
          <h2 class="cv__sh">{isFr ? "Expériences" : "Experience"}</h2>
          {
            experiences.map((exp) => (
              <div class="cv__block">
                <div class="cv__block-content">
                  <div class="cv__bt-row">
                    <h3 class="cv__bt">{exp.title} <span class="cv__bt-org">– {exp.org}</span></h3>
                    {exp.logo && (
                      <div class="cv__logo-container">
                        <img 
                          src={exp.logo} 
                          alt={exp.org} 
                          class={`cv__logo logo--${exp.logo.split('/').pop().split('.')[0]}`} 
                        />
                      </div>
                    )}
                  </div>
                  <div class="cv__meta-info">
                    <span class="cv__period">{exp.period}</span>
                    <span class="separator">&bull;</span>
                    <span class="cv__location">{exp.location}</span>
                  </div>
                  {exp.items.length > 0 && (
                    <ul class="cv__list">
                      {exp.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                  {exp.stack && (
                    <div class="cv__stack cv__chips">
                      {exp.stack.map((tech) => <span class="chip">{tech}</span>)}
                    </div>
                  )}
                  {(exp.projectsLink || exp.recommendationLink || exp.projectLink) && (
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.85rem;">
                      {exp.recommendationLink && (
                        <a href={exp.recommendationLink.url} target="_blank" rel="noopener noreferrer" class="chip chip--active cv__project-link" data-umami-event="Voir la lettre de recommandation">
                          <span>{exp.recommendationLink.text}</span>
                          <ArrowUpRight weight="bold" class="inline-icon" />
                        </a>
                      )}
                      {exp.projectLink && (
                        <a href={exp.projectLink.url} class="chip chip--active cv__project-link">
                          <span>{exp.projectLink.text}</span>
                          <ArrowUpRight weight="bold" class="inline-icon" />
                        </a>
                      )}
                      {exp.projectsLink && (
                        <a href={exp.projectsLink.url} class="chip chip--active cv__project-link">
                          <span>{exp.projectsLink.text}</span>
                          <ArrowUpRight weight="bold" class="inline-icon" />
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </section>
      </div>

      <div class="cv__col">
        <section class="cv__section reveal">
          <h2 class="cv__sh">{isFr ? "Formation" : "Education"}</h2>
          {
            education.map((edu) => (
              <div class="cv__block">
                <div class="cv__block-content">
                  <div class="cv__bt-row">
                    <h3 class="cv__bt">{edu.title}</h3>
                    {edu.logo && (
                      <div class="cv__logo-container">
                        <img 
                          src={edu.logo} 
                          alt="" 
                          class={`cv__logo logo--${edu.logo.split('/').pop().split('.')[0]}`} 
                      />
                      </div>
                    )}
                  </div>
                  <div class="cv__meta-info">
                    <span class="cv__period">{edu.period}</span>
                    <span class="separator">&bull;</span>
                    <span class="cv__location">{edu.location}</span>
                  </div>
                  {edu.items.length > 0 && (
                    <ul class="cv__list">
                      {edu.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                  {edu.projectsLink && (
                    <div class="cv__project-wrapper">
                      <a href={edu.projectsLink.url} class="chip chip--active cv__project-link">
                        <span>{edu.projectsLink.text}</span>
                        <ArrowUpRight weight="bold" class="inline-icon" />
                      </a>
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </section>

        <section class="cv__section reveal">
          <h2 class="cv__sh">{isFr ? "Compétences" : "Skills"}</h2>
          {
            skills.map((group) => (
              <div class="cv__block cv__block--skills">
                <p class="cv__skills-label">{group.label}</p>
                <div class="cv__chips">
                  {group.items.map((skill) => <span class="chip">{skill}</span>)}
                </div>
              </div>
            ))
          }
        </section>

        <section class="cv__section reveal">
          <h2 class="cv__sh">{isFr ? "Langues" : "Languages"}</h2>
          <div class="cv__block cv__block--skills">
            <div class="cv__chips">
              {languages.map((lang) => <span class="chip">{lang}</span>)}
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: clamp(3rem, 8vw, 6rem);
    max-width: 1280px;
  }
  .cv__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cv__title {
    font-size: var(--text-4xl);
    margin-bottom: 0.35rem;
    line-height: 1.1;
  }
  .cv__subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.75rem;
    font-size: var(--text-sm);
    align-items: center;
    margin-top: 1.5rem;
    padding: 1rem 1.5rem;
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--hairline-2);
    box-shadow: var(--shadow-sm);
    width: fit-content;
    backdrop-filter: blur(8px);
    transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }
  .cv__contact:hover {
    border-color: var(--hairline);
    box-shadow: var(--shadow);
  }
  .cv__contact-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  a.cv__contact-item:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }
  .cv__contact-item svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }
  .inline-icon {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    vertical-align: -0.1em;
  }

  .cv__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .cv__col {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .cv__sh {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }
  .cv__block {
    position: relative;
    padding-left: 1.5rem;
    padding-bottom: 2rem;
    margin-bottom: 0;
  }
  .cv__block::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35rem;
    bottom: 0;
    width: 2px;
    background: var(--hairline-2);
  }
  .cv__block::after {
    content: "";
    position: absolute;
    left: -3px;
    top: 0.35rem;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    border: 2px solid var(--bg);
    transition: transform var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }
  .cv__block:last-child::before {
    display: none;
  }
  .cv__block:last-child {
    padding-bottom: 0;
  }
  .cv__block:hover::after {
    transform: scale(1.3);
    box-shadow: 0 0 0 3px var(--accent-tint);
  }
  .cv__block-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 0.4rem;
  }
  .cv__period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .cv__location {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .cv__bt-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .cv__bt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin-bottom: 0;
    transition: color var(--dur-fast) var(--ease);
  }
  .cv__bt-org {
    font-weight: 400;
    color: var(--ink-2);
    margin-left: 0.35rem;
  }
  .cv__block:hover .cv__bt {
    color: var(--accent);
  }
  .cv__meta-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--ink-3);
    margin-bottom: 0.85rem;
  }
  .cv__org-name {
    color: var(--ink-2);
    font-weight: 500;
  }
  .separator {
    color: var(--hairline);
    user-select: none;
  }
  .cv__logo-container {
    width: 90px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
  }
  .cv__logo-container:has(.logo--geochanvre) {
    width: 120px;
  }
  .cv__logo {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    flex-shrink: 0;
    transition: transform var(--dur-fast) var(--ease);
  }
  .logo--orange {
    height: 36px;
  }
  .logo--ufrj {
    height: 34px;
  }
  .logo--ntn-snr {
    height: 18px;
    margin-top: 0.1rem;
  }
  .logo--geochanvre {
    height: 24px;
  }
  .logo--rostand {
    height: 32px;
  }
  .logo--malherbe {
    height: 28px;
  }
  .logo--imt-mines-ales {
    height: 34px;
  }
  .cv__logo-container:hover .cv__logo {
    transform: scale(1.05);
  }
  .cv__list {
    list-style: none;
    display: flex;
    flex-direction: column;
