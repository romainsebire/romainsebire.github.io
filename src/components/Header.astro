---
import { List, X, ArrowUpRight } from "@phosphor-icons/react";
import {
  getLangFromUrl,
  getAltLangUrl,
  getNavItems,
  stripLocale,
  useTranslations,
} from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = getNavItems(lang);
const altUrl = getAltLangUrl(Astro.url);
const here = stripLocale(Astro.url.pathname).replace(/\/$/, "") || "/";

function isActive(href: string): boolean {
  const path = stripLocale(href).replace(/\/$/, "") || "/";
  return path === "/" ? here === "/" : here === path || here.startsWith(`${path}/`);
}
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__brand" href={items[0].href} aria-label="Romain Sebire - accueil">
      <img src="/images/profile/initials-logo.webp" alt="" width="34" height="34" />
      <span>Romain Sebire</span>
    </a>

    <nav class="nav__links" aria-label="Navigation principale">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={["nav__link", { "is-active": isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a class="nav__lang" href={altUrl} hreflang={lang === "fr" ? "en" : "fr"}>
        {t("lang.switchTo")}
      </a>
      <button
        class="nav__burger"
        data-burger
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav__burger-icon"><List weight="bold" /></span>
        <span class="nav__burger-icon nav__burger-icon--close"><X weight="bold" /></span>
      </button>
    </div>
  </div>

  <div class="nav__overlay" id="mobile-menu" data-overlay hidden>
    <nav class="nav__overlay-links" aria-label="Navigation mobile">
      {
        items.map((item, i) => (
          <a
            href={item.href}
            class:list={["nav__overlay-link", { "is-active": isActive(item.href) }]}
            style={`--i:${i}`}
          >
            {item.label}
          </a>
        ))
      }
      <a class="nav__overlay-link nav__overlay-lang" href={altUrl} style={`--i:${items.length}`}>
        {lang === "fr" ? "English" : "Français"}
        <ArrowUpRight weight="bold" />
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: clamp(0.6rem, 2vw, 1.1rem) var(--gutter);
    pointer-events: none;
  }
  .nav__bar {
    pointer-events: auto;
    width: 100%;
    max-width: var(--container);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.6rem 0 1.25rem;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border: 1px solid var(--hairline-2);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    transition:
      box-shadow var(--dur) var(--ease),
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .nav[data-scrolled] .nav__bar {
    box-shadow: var(--shadow);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    border-color: var(--hairline);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
    white-space: nowrap;
  }
  .nav__brand img {
    border-radius: 50%;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav__link {
    position: relative;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.925rem;
    color: var(--ink-2);
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }
  .nav__link:hover {
    color: var(--ink);
    background: var(--bg-2);
  }
  .nav__link.is-active {
    color: var(--ink);
  }
  .nav__link.is-active::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav__lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.7rem;
    height: 2.7rem;
    padding: 0 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .nav__lang:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .nav__burger {
    display: none;
    position: relative;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
    color: var(--ink);
  }
  .nav__burger-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur) var(--ease);
  }
  .nav__burger-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .nav__burger-icon--close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  .nav[data-open] .nav__burger-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .nav[data-open] .nav__burger-icon--close {
    opacity: 1;
    transform: none;
  }

  /* ---- Mobile overlay ---- */
  .nav__overlay {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: -1;
    display: grid;
    align-content: center;
    padding: 6rem var(--gutter) 3rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .nav__overlay[hidden] {
    display: none;
  }
  .nav[data-open] .nav__overlay {
    opacity: 1;
    transform: none;
  }
  .nav__overlay-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: var(--container);
    margin-inline: auto;
    width: 100%;
  }
  .nav__overlay-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 9vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
    border-bottom: 1px solid var(--hairline-2);
    opacity: 0;
    transform: translateY(14px);
  }
  .nav[data-open] .nav__overlay-link {
    animation: nav-reveal var(--dur-slow) var(--ease-out) forwards;
    animation-delay: calc(0.06s * var(--i) + 0.08s);
  }
  .nav__overlay-link.is-active {
    color: var(--accent);
  }
  .nav__overlay-lang {
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    color: var(--ink-3);
  }
  .nav__overlay-lang svg {
    width: 1.2em;
    height: 1.2em;
  }

  @keyframes nav-reveal {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 820px) {
    .nav__links {
      display: none;
    }
    .nav__burger {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__overlay-link {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  function initNav() {
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    if (!nav || nav.dataset.bound === "true") return;
    nav.dataset.bound = "true";

    const burger = nav.querySelector<HTMLButtonElement>("[data-burger]");
    const overlay = nav.querySelector<HTMLElement>("[data-overlay]");

    const setOpen = (open: boolean) => {
      if (open) {
        overlay?.removeAttribute("hidden");
        nav.setAttribute("data-open", "");
      } else {
        nav.removeAttribute("data-open");
        window.setTimeout(() => overlay?.setAttribute("hidden", ""), 350);
      }
      burger?.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    };

    burger?.addEventListener("click", () =>
      setOpen(burger.getAttribute("aria-expanded") !== "true"),
    );
    overlay?.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false)),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.hasAttribute("data-open")) setOpen(false);
    });

    const onScroll = () => {
      if (window.scrollY > 8) nav.setAttribute("data-scrolled", "");
      else nav.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
