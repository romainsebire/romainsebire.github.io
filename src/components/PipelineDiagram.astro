---
import { CaretRight } from "@phosphor-icons/react";
import type { Lang } from "@i18n/ui";

interface Props {
  stages: { fr: string; en: string }[];
  lang: Lang;
}

const { stages, lang } = Astro.props;
---

{
  stages.length > 0 && (
    <figure class="pipeline" role="group">
      {stages.map((stage, i) => (
        <>
          <div class="pipeline__node">
            <span class="pipeline__idx">{String(i + 1).padStart(2, "0")}</span>
            <span class="pipeline__label">{stage[lang]}</span>
          </div>
          {i < stages.length - 1 && (
            <span class="pipeline__arrow" aria-hidden="true">
              <CaretRight weight="bold" />
            </span>
          )}
        </>
      ))}
    </figure>
  )
}

<style>
  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.5rem;
    margin: 0;
    padding: 1.25rem;
    background: var(--bg-2);
    border: 1px solid var(--hairline-2);
    border-radius: var(--radius);
  }
  .pipeline__node {
    flex: 1 1 0;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--hairline-2);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .pipeline__idx {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .pipeline__label {
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--ink);
  }
  .pipeline__arrow {
    display: grid;
    place-items: center;
    color: var(--ink-3);
    flex: 0 0 auto;
  }
  .pipeline__arrow svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  @media (max-width: 640px) {
    .pipeline {
      flex-direction: column;
    }
    .pipeline__arrow {
      transform: rotate(90deg);
      padding-block: 0.1rem;
    }
  }
</style>
