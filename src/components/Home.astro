---
import { getProjects, getFeatured } from "@lib/projects";
import { domainIcon } from "@lib/taxonomyIcons";
import { taxonomyLabel, localizedPath, useTranslations, type Lang } from "@i18n/ui";
import { site, socials } from "@config/site";
import { ArrowUpRight, ArrowRight, GithubLogo, LinkedinLogo } from "@phosphor-icons/react";

import { experiencesList } from "@config/experiences";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getProjects(lang);
const featured = (await getFeatured(lang)).slice(0, 3);

// Aggregate domain counts for the "areas of exploration" map.
const targetDomains = [
  "llm",
  "computer-vision",
  "self-supervised-learning",
  "reinforcement-learning",
  "time-series",
  "classification",
  "regression",
  "clustering",
  "software-engineering",
  "combinatorial-optimization",
  "data-engineering",
  "cybersecurity",
];

const counts = new Map<string, number>();
for (const p of projects) {
  for (const key of p.data.domains) counts.set(key, (counts.get(key) ?? 0) + 1);
}
const domains = targetDomains.map((key) => [key, counts.get(key) ?? 0] as [string, number]);

const projectsUrl = localizedPath("/projects", lang);
const experiencesUrl = localizedPath("/experiences", lang);

const experiences = experiencesList.map((e) => ({
  href: localizedPath(`/experiences/${e.slug}`, lang),
  img: e.img,
  kicker: e.kicker,
  title: e.title,
  summary: e.summary,
}));
---

<!-- ===== HERO (anti-centre split) ===== -->
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__intro">
      <h1 class="hero__name display">Romain<br />Sebire</h1>
      <p class="hero__role">{t("home.role")}</p>
      <p class="hero__statement">{t("home.statement")}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={projectsUrl}>
          {t("home.cta.projects")}
          <span class="btn__icon"><ArrowRight weight="bold" /></span>
        </a>
        <a class="btn btn--ghost" href={socials.email} data-umami-event="Hero Contact Click">
          {t("home.cta.contact")}
          <span class="btn__icon"><ArrowUpRight weight="bold" /></span>
        </a>
      </div>
    </div>

    <aside class="hero__card card">
      <div class="card__core hero__card-core">
        <img class="hero__avatar" src="/images/profile/avatar.webp" alt="Romain Sebire" width="64" height="64" />
        <p class="hero__current-label"><span class="hero__status-dot" aria-hidden="true"></span>{t("home.current.label")}</p>
        <p class="hero__current-value">{t("home.current.value")}</p>
        <div class="hero__links">
          <a href={socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" data-umami-event="Hero GitHub Click">
            <GithubLogo weight="regular" />
          </a>
          <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" data-umami-event="Hero LinkedIn Click">
            <LinkedinLogo weight="regular" />
          </a>
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- ===== SELECTED WORK (editorial index, hover preview) ===== -->
<section class="section container">
  <header class="sec-head sec-head--row reveal">
    <div>
      <h2 class="h2">{t("home.work.title")}</h2>
      <p class="lead">{t("home.work.intro")}</p>
    </div>
    <a class="sec-link" href={projectsUrl}>
      {t("home.work.all")}
      <ArrowRight weight="bold" />
    </a>
  </header>

  <div class="windex">
    {
      featured.map((p, i) => {
        const d = p.data;
        const PrimaryIcon = domainIcon[d.domains[0]];
        return (
          <a
            class="windex__row reveal"
            href={localizedPath(`/projects/${p.slug.replace(/^(fr|en)\//, "")}`, lang)}
            style={`transition-delay:${Math.min(i * 70, 350)}ms`}
          >
            <span class="windex__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="windex__preview" aria-hidden="true">
              {d.cover ? (
                <img src={d.cover} alt="" loading="lazy" />
              ) : (
                <span class="windex__ph">{PrimaryIcon && <PrimaryIcon weight="thin" />}</span>
              )}
            </span>
            <span class="windex__body">
              <span class="windex__title">{d.title.replace(/ (\:\s?)/g, "\u00A0$1")}</span>
              <span class="windex__tag">{d.date ? `${d.date} · ` : ""}{d.tagline.replace(/ (\:\s?)/g, "\u00A0$1")}</span>
            </span>
            <span class="windex__domains">
              {d.domains.slice(0, 2).map((key) => (
                <span class="chip">{taxonomyLabel(key, lang)}</span>
              ))}
            </span>
            <ArrowUpRight class="windex__arrow" weight="bold" />
          </a>
        );
      })
    }
  </div>
</section>

<!-- ===== TOPICS / DOMAINS ===== -->
<section class="section container">
  <header class="sec-head reveal">
    <h2 class="h2">{t("home.domains.title")}</h2>
    <p class="lead">{t("home.domains.intro")}</p>
  </header>

  <div class="domains">
    {
      domains.map(([key, count], i) => {
        const Icon = domainIcon[key];
        const word = count > 1 ? t("home.domains.count.plural") : t("home.domains.count");
        return (
          <a
            href={`${projectsUrl}?domain=${key}`}
            class="domain reveal"
            style={`transition-delay:${(i % 4) * 45}ms`}
          >
            <span class="domain__icon">{Icon && <Icon weight="light" />}</span>
            <span class="domain__name">{taxonomyLabel(key, lang)}</span>
            <span class="domain__count">{count} {word}</span>
          </a>
        );
      })
    }
  </div>
</section>

<!-- ===== EXPERIENCES ===== -->
<section class="section container">
  <header class="sec-head sec-head--row reveal">
    <div>
      <h2 class="h2">{t("home.exp.title")}</h2>
      <p class="lead">{t("home.exp.intro")}</p>
    </div>
    <a class="sec-link" href={experiencesUrl}>
      {t("home.exp.all")}
      <ArrowRight weight="bold" />
    </a>
  </header>

  <div class="exp-grid">
    {
      experiences.map((e, i) => (
        <a class="exp card card--interactive reveal" href={e.href} style={`transition-delay:${i * 80}ms`}>
          <article class="card__core exp__core">
            <div class="exp__figure">
              <img src={e.img} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="exp__body">
              <p class="exp__kicker">{e.kicker[lang]}</p>
              <h3 class="exp__title">{e.title[lang]}</h3>
              <p class="exp__summary muted">{e.summary[lang]}</p>
            </div>
          </article>
        </a>
      ))
    }
  </div>
</section>

<!-- ===== CONTACT ===== -->
<section class="section container">
  <div class="contact card reveal">
    <div class="card__core contact__core">
      <div>
        <h2 class="h2 contact__title">{t("home.contact.title")}</h2>
        <p class="lead">{t("home.contact.text")}</p>
      </div>
      <div class="contact__actions">
        <a class="btn btn--primary" href={socials.email}>
          {t("home.contact.cta")}
          <span class="btn__icon"><ArrowUpRight weight="bold" /></span>
        </a>
        <a class="btn btn--ghost" href={lang === "fr" ? site.cvPath : site.cvEnPath} target="_blank" rel="noopener noreferrer">
          {t("home.contact.cv")}
          <span class="btn__icon"><ArrowRight weight="bold" /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: clamp(4.5rem, 8vw, 6.5rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  .hero__name {
    font-size: var(--text-5xl);
  }
  .hero__role {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .hero__statement {
    margin-top: 1rem;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 50ch;
    text-wrap: balance;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__card-core {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hero__avatar {
    width: 75px;
    height: 75px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    border: 1px solid var(--hairline);
    margin-bottom: 0.5rem;
  }
  .hero__current-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .hero__status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
    flex-shrink: 0;
  }
  .hero__current-value {
    font-size: var(--text-base);
    line-height: 1.45;
    color: var(--ink);
  }
  .hero__links {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .hero__links a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
    color: var(--ink-2);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .hero__links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .hero__links svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* ---- Section heads ---- */
  .sec-head {
    max-width: 60ch;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .sec-head--row {
    max-width: none;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .sec-head--row > div {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .sec-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }
  .sec-link:hover {
    color: var(--accent);
  }
  .sec-link svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--dur) var(--ease);
  }
  .sec-link:hover svg {
    transform: translateX(3px);
  }

  /* ---- Domains map ---- */
  .domains {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .domain {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .domain:hover {
    background: var(--bg-2);
    color: var(--accent);
  }
  .domain__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: 0 0 auto;
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    color: var(--accent);
  }
  .domain__icon svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .domain__name {
    font-weight: 500;
    line-height: 1.2;
    flex: 1 1 auto;
  }
  .domain__count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* ---- Selected work editorial index ---- */
  .windex {
    border-top: 1px solid var(--hairline);
  }
  .windex__row {
    display: grid;
    grid-template-columns: auto 88px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    transition: transform var(--dur) var(--ease);
  }
  .windex__row:hover {
    transform: translateX(8px);
  }
  .windex__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .windex__preview {
    width: 88px;
    height: 60px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--hairline-2);
    background: var(--bg-2);
    opacity: 0.55;
    filter: grayscale(0.4);
    transition: opacity var(--dur) var(--ease), filter var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .windex__row:hover .windex__preview {
    opacity: 1;
    filter: none;
    transform: scale(1.04);
  }
  .windex__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .windex__ph {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--ink-3);
    background:
      radial-gradient(120% 120% at 80% -10%, var(--accent-tint), transparent 55%),
      repeating-linear-gradient(45deg, var(--hairline-2) 0 1px, transparent 1px 9px);
  }
  .windex__ph svg {
    width: 40%;
    height: 40%;
  }
  .windex__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .windex__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    line-height: 1.05;
    transition: color var(--dur-fast) var(--ease);
  }
  .windex__row:hover .windex__title {
    color: var(--accent);
  }
  .windex__tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .windex__domains {
    display: flex;
    gap: 0.4rem;
  }
  .windex__arrow {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--ink-3);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .windex__row:hover .windex__arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  /* ---- Experiences ---- */
  .exp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .exp {
    display: block;
    color: inherit;
  }
  .exp__core {
    overflow: hidden;
  }
  .exp__figure {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-2);
    border-radius: calc(var(--radius-lg) - 6px) calc(var(--radius-lg) - 6px) 0 0;
  }
  .exp__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .exp:hover .exp__figure img {
    transform: scale(1.04);
  }
  .exp__body {
    padding: 1.35rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .exp__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .exp__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .exp__summary {
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* ---- Contact ---- */
  .contact__core {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem);
  }
  .contact__title {
    margin-bottom: 0.5rem;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 820px) {
    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .windex__row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 1rem;
    }
    .windex__preview,
    .windex__domains {
      display: none;
    }
  }
</style>
