---
import { GithubLogo, LinkedinLogo, EnvelopeSimple, ArrowUpRight } from "@phosphor-icons/react";
import { getLangFromUrl, getNavItems, useTranslations } from "@i18n/ui";
import { site, socials } from "@config/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = getNavItems(lang);
const year = new Date().getFullYear();

const tagline =
  lang === "fr"
    ? "Ingénieur Data & IA"
    : "Data & AI Engineer";
const madeWith = lang === "fr" ? "Conçu avec Astro." : "Built with Astro.";
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__name" href={items[0].href}>{site.name}</a>
      <p class="footer__tagline muted">{tagline}</p>
      <div class="footer__socials">
        <a href={socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" data-umami-event="Footer GitHub Click">
          <GithubLogo weight="regular" />
        </a>
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" data-umami-event="Footer LinkedIn Click">
          <LinkedinLogo weight="regular" />
        </a>
        <a href={socials.email} aria-label={t("nav.contact")} data-umami-event="Footer Contact Click">
          <EnvelopeSimple weight="regular" />
        </a>
      </div>
    </div>

    <nav class="footer__nav" aria-label={lang === "fr" ? "Pied de page" : "Footer"}>
      {items.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>

  <div class="container footer__base">
    <p class="muted">© {year} {site.name}. {t("footer.rights")}.</p>
    <span class="footer__made muted">{madeWith}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
    margin-top: clamp(4rem, 10vw, 8rem);
  }
  .footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }
  .footer__tagline {
    margin-top: 0.6rem;
    max-width: 34ch;
    font-size: var(--text-sm);
  }
  .footer__socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
    color: var(--ink-2);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .footer__socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .footer__socials svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: var(--text-sm);
  }
  .footer__nav a {
    color: var(--ink-2);
    transition: color var(--dur-fast) var(--ease);
  }
  .footer__nav a:hover {
    color: var(--accent);
  }

  .footer__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline-2);
    font-size: var(--text-xs);
  }
  .footer__made {
    text-align: right;
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .footer__base {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    .footer__made {
      text-align: center;
    }
  }
</style>
